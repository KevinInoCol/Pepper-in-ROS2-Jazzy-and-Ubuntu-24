<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypelocation="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pepper_gazebo_plugin</name>
  <version>0.2.0</version>
  <description>Simulación de Pepper en Gazebo Harmonic (Tutorial V9): mundos y launch, con los nombres del V8.</description>
  <maintainer email="kevin.inofuente.colque.27@gmail.com">KevinInoCol</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>gazebo_model_velocity_plugin</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>pepper_control</exec_depend>
  <exec_depend>pepper_description</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
