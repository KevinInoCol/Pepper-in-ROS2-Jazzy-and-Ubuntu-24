# RViz2: equivalente a pepper_gazebo_plugin/config/pepper_sensors.rviz del V8
Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1.0
    Plane Cell Count: 20
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
    Show Names: false
    Marker Scale: 0.3
  - Class: rviz_default_plugins/RobotModel
    Name: RobotModel
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /pepper/robot_description
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/LaserScan
    Name: LaserScan
    Enabled: true
    Topic:
      Value: /pepper/laser_2
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Size (m): 0.04
    Style: Flat Squares
    Color Transformer: FlatColor
    Color: 255; 0; 0
  - Class: rviz_default_plugins/LaserScan
    Name: Hokuyo
    Enabled: false
    Topic:
      Value: /pepper/hokuyo_scan
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Size (m): 0.03
    Style: Flat Squares
    Color Transformer: FlatColor
    Color: 0; 170; 255
  - Class: rviz_default_plugins/PointCloud2
    Name: PointCloud2
    Enabled: true
    Topic:
      Value: /pepper/camera/depth/points
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Size (m): 0.01
    Style: Flat Squares
    Color Transformer: AxisColor
    Axis: Z
  - Class: rviz_default_plugins/Range
    Name: Sonar_Back
    Enabled: true
    Topic:
      Value: /pepper/sonar_back
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Color: 255; 255; 0
    Alpha: 0.4
  - Class: rviz_default_plugins/Range
    Name: Sonar_Front
    Enabled: true
    Topic:
      Value: /pepper/sonar_front
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Color: 255; 255; 0
    Alpha: 0.4
  - Class: rviz_default_plugins/Odometry
    Name: Odometry
    Enabled: true
    Topic:
      Value: /pepper/odom
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Keep: 50
    Shape:
      Value: Arrow
      Color: 255; 25; 0
      Shaft Length: 0.3
      Shaft Radius: 0.02
      Head Length: 0.08
      Head Radius: 0.05
    Covariance:
      Value: false
  - Class: rviz_default_plugins/Odometry
    Name: GroundTruth_Odom
    Enabled: true
    Topic:
      Value: /pepper/odom_groundtruth
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Keep: 50
    Shape:
      Value: Arrow
      Color: 0; 200; 0
      Shaft Length: 0.3
      Shaft Radius: 0.02
      Head Length: 0.08
      Head Radius: 0.05
    Covariance:
      Value: false
  - Class: rviz_default_plugins/Image
    Name: Front_Camera
    Enabled: true
    Topic:
      Value: /pepper/camera/front/image_raw
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Image
    Name: Bottom_Camera
    Enabled: true
    Topic:
      Value: /pepper/camera/bottom/image_raw
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Image
    Name: Depth_Camera
    Enabled: true
    Topic:
      Value: /pepper/camera/depth/image_raw
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Normalize Range: false
    Min Value: 0.4
    Max Value: 8.0
  Global Options:
    Fixed Frame: base_footprint
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Value: /initialpose
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6.0
      Focal Point:
        X: 0.5
        Y: 0
        Z: 0.3
      Pitch: 0.7
      Yaw: 3.4
Window Geometry:
  Width: 1400
  Height: 900
