<sdf version="1.4">
  <model name="floor_lamp">
    <static>1</static>
    <link name="link">

      <collision name="colision1">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://floor_lamp/meshes/floor_lamp.stl</uri>
	    <scale> 1 1 1 </scale>
          </mesh>
        </geometry>
        <surface>
          <bounce />
          <friction>
            <ode />
          </friction>
          <contact>
            <ode />
          </contact>
        </surface>
      </collision>

      <visual name="visual1">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://floor_lamp/meshes/floor_lamp.stl</uri>
	    <scale> 1 1 1 </scale>
          </mesh>
        </geometry>
        <material>
          <!-- V8: script Gazebo/Grey (Gazebo Classic) -->
          <ambient>0.70 0.70 0.70 1</ambient>
          <diffuse>0.70 0.70 0.70 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <velocity_decay>
        <linear>0.000000</linear>
        <angular>0.000000</angular>
      </velocity_decay>
      <self_collide>0</self_collide>
      <kinematic>0</kinematic>
      <gravity>1</gravity>
    </link>
  </model>
</sdf>
