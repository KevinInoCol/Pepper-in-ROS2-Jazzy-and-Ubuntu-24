<?xml version="1.0"?>
<!-- Pepper 1.0 (V9, ROS 2 Jazzy). Modelo y nombres del V8 (marco-quiroz/pepper_robot):
     árbol con raíz en base_footprint -> Tibia -> Pelvis -> Hip -> torso. -->
<robot name="JulietteY20MP" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Dedos: el V8 los deja fuera en simulación (pepper_robot_CPU.xacro) -->
  <xacro:arg name="fingers" default="false"/>

  <xacro:include filename="$(find pepper_description)/urdf/pepper_visual_collisions.xacro"/>
  <xacro:include filename="$(find pepper_description)/urdf/pepper_head.xacro"/>
  <xacro:include filename="$(find pepper_description)/urdf/pepper_legs.xacro"/>
  <xacro:include filename="$(find pepper_description)/urdf/pepper_torso.xacro"/>
  <xacro:include filename="$(find pepper_description)/urdf/pepper_arms.xacro"/>
  <xacro:include filename="$(find pepper_description)/urdf/pepper_sensors.xacro"/>
  <xacro:include filename="$(find pepper_description)/urdf/pepper_wheels.xacro"/>
  <xacro:if value="$(arg fingers)">
    <xacro:include filename="$(find pepper_description)/urdf/pepper_fingers.xacro"/>
  </xacro:if>
</robot>
